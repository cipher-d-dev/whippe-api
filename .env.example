# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
# Replace with your MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/whippe

# ─── Session / Auth ──────────────────────────────────────────────────────────
# Minimum 32 characters — generate a strong random secret for production
JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-chars

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Frontend URL — used for OAuth redirects after Google login
FRONTEND_URL=http://localhost:3000

# ─── Office Geofence — DAAR Communications HQ ────────────────────────────────
# Replace with the real coordinates of the DAAR Communications building
OFFICE_LAT=6.4281
OFFICE_LNG=3.4219
OFFICE_RADIUS_METERS=100

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI must include: http://localhost:5000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ─── Appwrite Storage ─────────────────────────────────────────────────────────
# Create a project at https://cloud.appwrite.io
# Required in production — optional in development
# APPWRITE_ENDPOINT: your Appwrite instance URL, e.g. https://cloud.appwrite.io/v1
# APPWRITE_PROJECT_ID: found in Project Settings
# APPWRITE_BUCKET_ID: Storage → Buckets → your bucket ID
# APPWRITE_API_KEY: API Keys → create a key with storage.read + storage.write scope
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6ace4f7c001037c4da51
APPWRITE_BUCKET_ID=
APPWRITE_API_KEY=
